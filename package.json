    "build:ios:test": "eas build --profile preview --platform ios",
    "build:ios:prod": "eas build --profile production --platform ios",
    "build:android:test": "eas build --profile preview --platform android",
    "build:android:prod": "eas build --profile production --platform android",
    "build:test": "eas build --profile preview --platform all",
    "build:prod": "eas build --profile production --platform all",
    "web": "expo start --web"

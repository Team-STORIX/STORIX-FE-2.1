{
  "expo": {
    "name": "STORIX",
    "slug": "STORIX-FE-21",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-logo.png",
    "scheme": "storixfe21",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/common/logo-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "40",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": [
          "ko"
        ]
      }
    },
    "android": {
      "versionCode": 19,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "344d3d813aee8e9a15d97762d2da1001",
          "kotlinVersion": "2.1.20"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/common/logo-white.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/icons/common/logo-white.png",
            "imageWidth": 120,
            "resizeMode": "contain",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "versionDate": "26.08.19",
      "router": {},
      "eas": {
        "projectId": "0f0e53f8-987b-48b6-bc8a-a463c57b236e"
      }
    },
    "owner": "storix-dev"
  }
}
